---
const { siteConfig } = Astro.props;
const hasProjects = siteConfig?.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24 overflow-hidden bg-white">
      <div>
        
        {/* Consistent Grid Header matching About.astro */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start mb-12">
          
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 tracking-tight">
              {siteConfig.ui?.projects || "Projects"}
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          {/* Filter Tabs aligned on the right */}
          <div class="lg:col-span-8 flex flex-wrap items-center gap-2 pt-2" id="project-filters">
            <button
              data-filter="all"
              class="filter-btn px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 bg-gray-900 text-white shadow-md cursor-pointer"
            >
              All
            </button>
            <button
              data-filter="blender"
              class="filter-btn px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer"
            >
              Blender & Tools
            </button>
            <button
              data-filter="games"
              class="filter-btn px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer"
            >
              Games
            </button>
            <button
              data-filter="web"
              class="filter-btn px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer"
            >
              Web & Backend
            </button>
          </div>

        </div>

        {/* Skewed Expanding Diagonal Accordion Gallery */}
        <div class="accordion-gallery" id="projects-gallery">
          {siteConfig.projects.map((project: any, index: number) => {
            const projectSkills = project.skillNames || project.skills || [];
            const category = project.category || (
              project.name.toLowerCase().includes("blender") ? "blender" :
              project.name.toLowerCase().includes("game") || project.name.toLowerCase().includes("racing") ? "games" : "web"
            );

            return (
              <div
                class="slice group"
                data-category={category}
                style={`--accent: ${siteConfig.accentColor || "#111827"}`}
              >
                {/* Media Layer (Counter-skewed so images/videos stay straight) */}
                {project.image && (
                  project.image.endsWith(".mp4") ? (
                    <video
                      src={project.image}
                      autoplay
                      loop
                      muted
                      playsinline
                      class="slice-media"
                    />
                  ) : (
                    <img
                      src={project.image}
                      alt={project.name}
                      class="slice-media"
                    />
                  )
                )}

                {/* Gradient Backdrop */}
                <div class="slice-backdrop" />

                {/* ALWAYS VISIBLE (Collapsed State Header - Tech Stack & Name) */}
                <div class="slice-collapsed-label">
                  <div class="flex items-center justify-between w-full mb-1">
                    <span class="text-xs font-mono font-bold opacity-80" style={`color: ${siteConfig.accentColor}`}>
                      0{index + 1}
                    </span>
                  </div>

                  {projectSkills.length > 0 && (
                    <div class="flex flex-wrap gap-1 mb-2">
                      {projectSkills.map((skillName: string) => {
                        const matchedSkill = siteConfig.skills?.find(
                          (s: any) => s.name.toLowerCase() === skillName.toLowerCase()
                        );

                        return (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-black/70 border border-white/15 backdrop-blur-xs text-white rounded text-[10px] font-medium">
                            {matchedSkill?.icon && (
                              <img
                                src={matchedSkill.icon}
                                alt={skillName}
                                class="w-3 h-3 object-contain brightness-0 invert"
                              />
                            )}
                            {skillName}
                          </span>
                        );
                      })}
                    </div>
                  )}

                  <h4 class="text-sm sm:text-base font-black text-white truncate tracking-tight">
                    {project.name}
                  </h4>
                </div>

                {/* EXPANDED CONTENT PANEL (Revealed on Hover) */}
                <div class="slice-content">
                  <div class="flex items-center justify-between gap-4 mb-3">
                    <span
                      class="text-xs font-mono font-bold px-2.5 py-0.5 rounded bg-white/15 text-white backdrop-blur-xs uppercase tracking-wider"
                    >
                      0{index + 1} // {category}
                    </span>

                    {project.link && (
                      <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white text-gray-900 text-xs font-bold hover:bg-gray-200 transition-colors shadow-lg"
                      >
                        <span>Open</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7V17" />
                        </svg>
                      </a>
                    )}
                  </div>

                  <h3 class="text-xl sm:text-2xl md:text-3xl font-black text-white leading-tight mb-2">
                    {project.name}
                  </h3>

                  <p class="text-xs sm:text-sm text-gray-200 leading-relaxed mb-4 max-w-xl">
                    {project.description}
                  </p>

                  {projectSkills.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {projectSkills.map((skillName: string) => {
                        const matchedSkill = siteConfig.skills?.find(
                          (s: any) => s.name.toLowerCase() === skillName.toLowerCase()
                        );

                        return (
                          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-black/75 border border-white/15 backdrop-blur-xs text-white rounded-md text-xs font-semibold">
                            {matchedSkill?.icon && (
                              <img
                                src={matchedSkill.icon}
                                alt={skillName}
                                class="w-3.5 h-3.5 object-contain brightness-0 invert"
                              />
                            )}
                            {skillName}
                          </span>
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>

      </div>
    </section>
  )
}

<style>
  .accordion-gallery {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 0.85rem;
    height: 68vh;
    min-height: 480px;
    max-height: 680px;
    transform: skew(-6deg);
  }

  .slice {
    flex: 1;
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background: #111827;
    cursor: pointer;
    transition: flex 0.45s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease, transform 0.3s ease, margin 0.4s ease;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.25);
  }

  .slice:hover {
    flex: 8;
  }

  .slice.is-hidden {
    flex: 0 0 0% !important;
    opacity: 0;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    pointer-events: none;
    transform: scale(0.9);
  }

  .slice-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: skew(6deg) scale(1.25);
    filter: grayscale(80%) brightness(0.6);
    transition: filter 0.4s ease, transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .slice:hover .slice-media {
    filter: grayscale(0%) brightness(0.85);
    transform: skew(6deg) scale(1.12);
  }

  .slice-backdrop {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.5) 45%,
      rgba(0, 0, 0, 0.15) 100%
    );
    opacity: 0.85;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .slice:hover .slice-backdrop {
    opacity: 0.95;
  }

  .slice-collapsed-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 1rem;
    transform: skew(6deg);
    display: flex;
    flex-direction: column;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 15;
    pointer-events: none;
  }

  .slice:hover .slice-collapsed-label {
    opacity: 0;
    transform: skew(6deg) translateY(10px);
  }

  .slice-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 2.25rem;
    transform: skew(6deg) translateY(16px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease 0.1s, transform 0.35s cubic-bezier(0.25, 1, 0.5, 1) 0.1s;
    z-index: 20;
  }

  .slice:hover .slice-content {
    opacity: 1;
    transform: skew(6deg) translateY(0);
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .accordion-gallery {
      flex-direction: column;
      height: auto;
      max-height: none;
      transform: none;
    }

    .slice {
      flex: none;
      height: 220px;
      transform: none;
    }

    .slice:hover {
      flex: none;
      height: 340px;
    }

    .slice.is-hidden {
      height: 0 !important;
      margin: 0 !important;
    }

    .slice-media {
      transform: scale(1.05);
    }

    .slice:hover .slice-media {
      transform: scale(1.02);
    }

    .slice-collapsed-label {
      transform: none;
    }

    .slice:hover .slice-collapsed-label {
      transform: translateY(10px);
    }

    .slice-content {
      transform: translateY(10px);
      padding: 1.25rem;
    }

    .slice:hover .slice-content {
      transform: translateY(0);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filterButtons = document.querySelectorAll(".filter-btn");
    const slices = document.querySelectorAll(".slice");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => {
          b.classList.remove("bg-gray-900", "text-white", "shadow-md");
          b.classList.add("bg-gray-100", "text-gray-700");
        });
        btn.classList.remove("bg-gray-100", "text-gray-700");
        btn.classList.add("bg-gray-900", "text-white", "shadow-md");

        const filter = btn.getAttribute("data-filter");

        slices.forEach((slice) => {
          const category = slice.getAttribute("data-category");
          const el = slice as HTMLElement;

          if (filter === "all" || category === filter) {
            el.classList.remove("is-hidden");
          } else {
            el.classList.add("is-hidden");
          }
        });
      });
    });
  });
</script>